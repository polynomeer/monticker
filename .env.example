# Database
DB_URL=jdbc:postgresql://localhost:5432/monticker
DB_USER=monticker
DB_PASSWORD=monticker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI APIs (optional)
ANTHROPIC_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=

# KIS (optional)
KIS_APP_KEY=
KIS_APP_SECRET=

# JWT
# jwt.secret in application.yml — override for production

# Order Book Provider
# yahoo  → Yahoo Finance 15분 지연 실데이터 (계좌 불필요)
# (미설정) → Mock
ORDERBOOK_PROVIDER=yahoo

# 토스페이먼츠 (optional — 비어 있으면 Mock PG로 동작한다)
#
# 둘 다 설정하고 PG_MOCK_ENABLED=false 로 띄워야 실결제 경로가 열린다 (ADR-059):
#   TOSS_SECRET_KEY            백엔드 — 결제 승인·빌링키 발급. test_sk_... 또는 live_sk_...
#   NEXT_PUBLIC_TOSS_CLIENT_KEY 프론트 — 결제창 SDK. 브라우저에 노출되는 공개 키다
#
# 프론트는 이 클라이언트 키의 유무로 결제 경로를 고른다 — 없으면 Mock PG의 /subscribe,
# 있으면 /payment/prepare → 토스 SDK → /payment/confirm (services/payment.ts).
# 발급: https://developers.tosspayments.com → 내 상점 → 연동 정보
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Alerting (resilience-plan P0-3)
# Slack Incoming Webhook URL. 비어 있으면 Alertmanager가 무발송 모드로 뜬다 — 운영에서는 필수.
# 채널 #monticker-alerts-page(critical) / #monticker-alerts(warning)를 미리 만들어 둘 것.
SLACK_WEBHOOK_URL=
