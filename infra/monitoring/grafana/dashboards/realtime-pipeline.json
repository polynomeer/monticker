    {
      "type": "timeseries",
      "title": "브로드캐스트 in → out (msg/s)",
      "targets": [
        {
          "expr": "sum(rate(ws_broadcast_ticks_in_total{job=\"monticker-api\"}[1m]))",
          "legendFormat": "ticks in",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ws_broadcast_messages_out_total{job=\"monticker-api\"}[1m]))",
          "legendFormat": "messages out",
          "refId": "B"
        },
        {
          "expr": "sum(rate(ws_market_summary_relayed_total{job=\"monticker-api\"}[1m]))",
          "legendFormat": "summary relayed",
          "refId": "C"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
