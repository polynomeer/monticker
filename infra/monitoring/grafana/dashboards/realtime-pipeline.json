{
  "uid": "monticker-realtime-pipeline",
  "title": "monticker — Realtime Pipeline",
  "tags": [
    "monticker",
    "realtime"
  ],
  "schemaVersion": 38,
  "refresh": "15s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "유입 — Kafka market.ticks",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "틱 처리량 (ticks/s, worker)",
      "targets": [
        {
          "expr": "sum(rate(tick_latency_total_pipeline_seconds_count{job=\"monticker-worker\"}[1m]))",
          "legendFormat": "processed/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "L-03: 단일 파티션 600/s → 동시성 4에서 5,000/s (ADR-044/046)",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "컨슈머 랙 (market.ticks, 파티션 최대)",
      "targets": [
        {
          "expr": "max by (job) (kafka_consumer_fetch_manager_records_lag_max{topic=\"market_ticks\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "TickPipelineStalled: 장중 3분간 처리 0 또는 랙 > 60,000 — runbook tick-stalled",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "단계별 지연 p99 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tick_latency_redis_write_seconds_bucket{job=\"monticker-worker\"}[1m]))) * 1000",
          "legendFormat": "redis write",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tick_latency_broadcast_seconds_bucket{job=\"monticker-worker\"}[1m]))) * 1000",
          "legendFormat": "broadcast",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tick_latency_total_pipeline_seconds_bucket{job=\"monticker-worker\"}[1m]))) * 1000",
          "legendFormat": "total pipeline",
          "refId": "C"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "§4.3 실시간 SLO p99 < 300ms",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "느린 틱 (> 임계, 건/min)",
      "targets": [
        {
          "expr": "sum(rate(tick_pipeline_slow_total{job=\"monticker-worker\"}[1m])) * 60",
          "legendFormat": "slow/min",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "ADR-046: 틱마다 WARN 찍던 것을 카운터로. 백로그를 소화 중이면 정상적으로 튄다",
      "id": 5
    },
    {
      "type": "row",
