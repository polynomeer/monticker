    {
      "type": "stat",
      "title": "conflation 비율 (out/in)",
      "targets": [
        {
          "expr": "sum(rate(ws_broadcast_messages_out_total{job=\"monticker-api\"}[5m])) / sum(rate(ws_broadcast_ticks_in_total{job=\"monticker-api\"}[5m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 26
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
