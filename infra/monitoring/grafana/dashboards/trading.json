{
  "uid": "monticker-trading",
  "title": "monticker — Trading",
  "tags": [
    "monticker",
    "trading"
  ],
  "schemaVersion": 38,
  "refresh": "15s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "주문 — 사가 (모의투자) · 실거래",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "주문 TPS (사가)",
      "targets": [
        {
          "expr": "sum(rate(matching_saga_submit_seconds_count{job=\"monticker-api\"}[1m]))",
          "legendFormat": "orders/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "주문 지연 p50 / p99 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(matching_saga_submit_seconds_bucket{job=\"monticker-api\"}[5m]))) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(matching_saga_submit_seconds_bucket{job=\"monticker-api\"}[5m]))) * 1000",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "주문 상태 전이 (건/min)",
      "targets": [
        {
          "expr": "sum by (to) (rate(order_state_transition_total{job=\"monticker-api\"}[1m])) * 60",
          "legendFormat": "→ {{to}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "주문 경로 5xx (OrderPathDown)",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"monticker-api\", uri=~\"/api/(matching|paper|brokerage)/.*\", status=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "OrderPathDown 알람: 주문 경로 5xx가 2분간 지속되면 page",
      "id": 5
    },
    {
      "type": "row",
      "title": "리스크 게이트 (ADR-025) — 거부율이 갑자기 오르면 룰이 아니라 데이터를 의심할 것 (DailyLossRule 사례)",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 17
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "리스크 판정 (건/min)",
      "targets": [
        {
          "expr": "sum by (result) (rate(risk_check_total{job=\"monticker-api\"}[5m])) * 60",
