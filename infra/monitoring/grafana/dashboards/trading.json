      "id": 7
    },
    {
      "type": "timeseries",
      "title": "거부 룰별 (건/min)",
      "targets": [
        {
          "expr": "sum by (rule) (rate(risk_check_total{job=\"monticker-api\", result=\"blocked\"}[5m])) * 60",
          "legendFormat": "{{rule}}",
          "refId": "A"
