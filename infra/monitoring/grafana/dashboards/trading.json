    {
      "type": "stat",
      "title": "거부율 (5m)",
      "targets": [
        {
          "expr": "sum(rate(risk_check_total{job=\"monticker-api\", result=\"blocked\"}[5m])) / sum(rate(risk_check_total{job=\"monticker-api\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 26
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "정상 거래에서 30%를 넘으면 룰 입력(잔고·일봉)이 깨진 것",
      "id": 9
    },
    {
