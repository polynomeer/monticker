{
  "uid": "monticker-capacity",
  "title": "monticker — Capacity (주간 리뷰)",
  "tags": [
    "monticker",
    "capacity"
  ],
  "schemaVersion": 38,
  "refresh": "5m",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "성장 추이 — scale-out-plan §2 T1/T2 기준선과 비교 (7일 창)",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "틱 처리량 (ticks/s, 1h 평균)",
      "targets": [
        {
          "expr": "sum(rate(tick_latency_total_pipeline_seconds_count{job=\"monticker-worker\"}[1h]))",
          "legendFormat": "ticks/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "T1 목표 12,000 종목 × 1/s. L-03 실측 상한: 동시성 4에서 5,000/s",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "HTTP 처리율 (req/s, 1h 평균)",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"monticker-api\", uri!~\"/actuator.*\"}[1h]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "WS 동접 (합)",
      "targets": [
        {
          "expr": "sum(ws_active_connections{job=\"monticker-api\"})",
          "legendFormat": "connections",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "L-02: pod당 500 연결에서 p99 159ms. ADR-045 §4.3 SLO는 5,000 conn",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "주문 TPS (1h 평균)",
      "targets": [
        {
          "expr": "sum(rate(matching_saga_submit_seconds_count{job=\"monticker-api\"}[1h]))",
          "legendFormat": "orders/s",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "처리 여유 — 랙 · 풀 · 큐",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 17
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "파티션당 처리량 (ticks/s ÷ 파티션 수)",
      "targets": [
        {
          "expr": "sum(rate(tick_latency_total_pipeline_seconds_count{job=\"monticker-worker\"}[1h])) / count(count by (partition) (kafka_consumer_fetch_manager_records_lag_max{topic=\"market_ticks\"}))",
          "legendFormat": "per partition",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "ADR-040 산정 근거 ~2,000/s per partition — 실측이 이 값에 가까워지면 파티션 증설(장 마감 후)",
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Hikari 사용률 (%, 서비스별)",
      "targets": [
        {
          "expr": "sum by (job) (hikaricp_connections_active) / sum by (job) (hikaricp_connections_max) * 100",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "백테스트 큐 잔여 / 스레드",
      "targets": [
        {
          "expr": "min(executor_queue_remaining_tasks{job=\"monticker-api\", name=\"backtestExecutor\"})",
          "legendFormat": "queue remaining (20)",
          "refId": "A"
        },
        {
          "expr": "max(executor_active_threads{job=\"monticker-api\", name=\"backtestExecutor\"})",
          "legendFormat": "active threads (max 4)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "BacktestQueueSaturated. L-06: bulkhead 안에서 조회 p95 무영향",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "JVM heap 최대 대비 사용 (%)",
      "targets": [
        {
          "expr": "max by (job) (jvm_memory_used_bytes{area=\"heap\"}) / max by (job) (jvm_memory_max_bytes{area=\"heap\"}) * 100",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
