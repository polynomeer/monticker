# ../secret.yaml과 동일한 이름(monticker-secrets)의 Secret을 만들어낸다 — api.yaml/worker.yaml 등
# 기존 매니페스트는 전혀 수정할 필요가 없다. remoteRef.key는 AWS Secrets Manager에 그 이름으로
# 값을 미리 등록해 둬야 한다(예: `aws secretsmanager create-secret --name monticker/kis-app-key`).
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: monticker-secrets
  namespace: monticker
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: monticker-secret-store
    kind: SecretStore
  target:
    name: monticker-secrets # ../secret.yaml이 만들던 Secret과 동일한 이름
    creationPolicy: Owner
  data:
    - secretKey: DB_USER
      remoteRef: { key: monticker/db-user }
    - secretKey: DB_PASSWORD
      remoteRef: { key: monticker/db-password }
    - secretKey: ANTHROPIC_API_KEY
      remoteRef: { key: monticker/anthropic-api-key }
    - secretKey: NAVER_CLIENT_ID
      remoteRef: { key: monticker/naver-client-id }
    - secretKey: NAVER_CLIENT_SECRET
      remoteRef: { key: monticker/naver-client-secret }
    - secretKey: DART_API_KEY
      remoteRef: { key: monticker/dart-api-key }
    - secretKey: KIS_APP_KEY
      remoteRef: { key: monticker/kis-app-key }
    - secretKey: KIS_APP_SECRET
      remoteRef: { key: monticker/kis-app-secret }
    - secretKey: TOSS_SECRET_KEY
      remoteRef: { key: monticker/toss-secret-key }
    - secretKey: CREDENTIAL_ENCRYPTION_KEY
      remoteRef: { key: monticker/credential-encryption-key }
    - secretKey: JWT_SECRET
      remoteRef: { key: monticker/jwt-secret }
    - secretKey: MAIL_HOST
      remoteRef: { key: monticker/mail-host }
    - secretKey: MAIL_PORT
      remoteRef: { key: monticker/mail-port }
    - secretKey: MAIL_USERNAME
      remoteRef: { key: monticker/mail-username }
    - secretKey: MAIL_PASSWORD
      remoteRef: { key: monticker/mail-password }
    - secretKey: MAIL_FROM
      remoteRef: { key: monticker/mail-from }
    - secretKey: APP_BASE_URL
      remoteRef: { key: monticker/app-base-url }
    - secretKey: ALLOWED_ORIGINS
      remoteRef: { key: monticker/allowed-origins }
