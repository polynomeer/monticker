# External Secrets Operator가 설치되어 있어야 한다: https://external-secrets.io
# 사용법은 이 디렉터리의 README.md 참고. AWS Secrets Manager는 예시일 뿐 — Vault/GCP로
# 바꾸려면 provider 블록만 https://external-secrets.io/latest/provider/ 에서 교체한다.
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: monticker-secret-store
  namespace: monticker
spec:
  provider:
    aws:
      service: SecretsManager
      region: <ap-northeast-2>  # 실제 리전으로 교체
      auth:
        # IRSA(IAM Roles for Service Accounts) 권장 — 정적 access key를 클러스터에 두지 않는다.
        jwt:
          serviceAccountRef:
            name: monticker-external-secrets
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: monticker-external-secrets
  namespace: monticker
  annotations:
    # IRSA용 IAM Role ARN — 이 Role은 SecretsManager:GetSecretValue 권한만 최소로 부여한다.
    eks.amazonaws.com/role-arn: <arn:aws:iam::ACCOUNT_ID:role/monticker-secrets-reader>
