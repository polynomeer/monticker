# ─────────────────────────────────────────────────────────────────
# Pinpoint Agent 3.1.0 — Release Profile (플러그인·계측 토글 전용)
#
# 이 파일은 에이전트 이미지에 들어 있는 tarball 기본 profile을 docker-compose가 bind mount로
# 덮어쓴다(api/worker 서비스의 volumes 참고). Pinpoint는 로컬 전용이므로(ADR-054) compose가
# 유일한 적용 지점이다 — 빌드 컨텍스트가 backend/api 라서 Dockerfile에서는 이 파일에 닿지 못한다.
#
# ⚠️ root config(pinpoint-root.config)가 정의하는 키는 여기에 써도 무시된다. 아래 설명 참고.
# ─────────────────────────────────────────────────────────────────

# ── Collector 주소·샘플링은 여기서 설정할 수 없다 ────────────────
#
# 에이전트 tarball의 **root** config(pinpoint-root.config)가 아래 키들을 이미 정의하고 있고,
# root가 profile보다 우선한다. 그래서 여기에 써도 전부 무시된다 — 실제로 그랬다:
#
#   profiler.transport.grpc.collector.ip        (root: 127.0.0.1)
#   profiler.transport.grpc.{agent,metadata,stat,span}.collector.port
#   profiler.sampling.type, profiler.sampling.counting.sampling-rate  (root: 1)
#
# 게다가 `${PINPOINT_COLLECTOR_IP:pinpoint-collector}` 같은 환경변수 플레이스홀더는 에이전트가
# 해석하지 않는다(3.1.0에서 확인 — 배너에 치환되지 않은 문자열이 그대로 찍힌다).
#
# 이 키들은 Dockerfile ENTRYPOINT가 `-D` 시스템 프로퍼티로 넘긴다
# (PINPOINT_COLLECTOR_IP / PINPOINT_SAMPLING_RATE 환경변수 → -Dprofiler.…).
# 시스템 프로퍼티는 root config보다도 우선하므로 그 경로만 실제로 동작한다.
# 자세한 경위는 ADR-054 참고.
#
# 아래부터는 root config가 정의하지 않는 키들이라 이 파일에서 정상적으로 적용된다.

# ── OTel SDK 이중 계측 방지 ───────────────────────────────────────
# micrometer-tracing-bridge-otel 이 이미 OTel span을 생성한다.
# Pinpoint가 OTel API 클래스를 추가로 계측하면 중복 span이 생기므로 비활성화한다.
# Jaeger 분산 추적은 OTel → Jaeger 경로를 유지하고,
# Pinpoint는 SQL/메서드 수준 APM 전용으로 사용한다.
profiler.opentelemetry.sdk.api.trace.enable=false

# ── 플러그인 활성화 ───────────────────────────────────────────────
profiler.tomcat.enable=true
profiler.spring.enable=true
profiler.spring.async.enable=true
profiler.spring.boot.enable=true
profiler.spring.boot.spring-boot.bootstrap.main=true
profiler.jdbc.enable=true
profiler.jdbc.postgresql.enable=true
profiler.redis.enable=true
profiler.redis.lettuce.enable=true
profiler.kafka.enable=true
profiler.kafka.producer.enable=true
profiler.kafka.consumer.enable=true
profiler.resttemplate.enable=true
profiler.httpclient5.enable=true
profiler.log4j.enable=false
profiler.logback.enable=true
profiler.logback.logging.transactioninfo=true    # 로그에 txId 자동 삽입

# ── SQL 파라미터 수집 (민감 정보 주의) ────────────────────────────
profiler.jdbc.sqlstatement.cache.size=1024
# true로 설정하면 SQL 바인딩 값도 수집 (개발 환경에서만 권장)
profiler.jdbc.tracesqlbindvalue=false

# ── HTTP 요청/응답 수집 ────────────────────────────────────────────
profiler.tomcat.tracerequestparam=true
profiler.tomcat.excludeurl=/actuator,/actuator/**
profiler.tomcat.excludemethod=OPTIONS

# ── 에러 추적 ─────────────────────────────────────────────────────
profiler.errorlog.enable=true

# ── 통계 전송 주기 ────────────────────────────────────────────────
profiler.jvm.collect.interval=1000
profiler.jvm.collect.detailed.metrics=true
