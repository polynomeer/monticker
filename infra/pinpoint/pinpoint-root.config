# ─────────────────────────────────────────────────────────────────
# Pinpoint Agent 3.1.0 — Root Configuration
# 이 파일은 에이전트 JAR(pinpoint-bootstrap-3.1.0.jar)와 같은 디렉토리에 위치해야 한다.
# Docker 이미지 내 경로: /pinpoint-agent/pinpoint-root.config
# ─────────────────────────────────────────────────────────────────

# 활성 프로파일 (profiles/release/pinpoint.config 로드)
pinpoint.profiler.profiles.active=release

# 전송 모듈: gRPC (Pinpoint 3.x 기본값, Collector 9991~9993 포트)
profiler.transport.module=GRPC
