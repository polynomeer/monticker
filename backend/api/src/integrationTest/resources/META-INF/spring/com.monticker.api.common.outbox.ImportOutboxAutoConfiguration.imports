# ADR-094 Outbox 격리 테스트(OutboxIsolationIntegrationTest)가 띄우는 자동 구성 — Boot 테스트 슬라이스와 같은 방식.
# Modulith 자동 구성 클래스는 package-private이라 클래스 리터럴로 고를 수 없다.
# 이름이 틀리면 조용히 빠진다 — Boot 4에서 자동 구성이 기술별 모듈(org.springframework.boot.<기술>.autoconfigure)로 옮겨졌다.
org.springframework.boot.jdbc.autoconfigure.DataSourceAutoConfiguration
org.springframework.boot.jdbc.autoconfigure.JdbcTemplateAutoConfiguration
org.springframework.boot.hibernate.autoconfigure.HibernateJpaAutoConfiguration
org.springframework.boot.transaction.autoconfigure.TransactionAutoConfiguration
org.springframework.boot.jackson.autoconfigure.JacksonAutoConfiguration
org.springframework.modulith.events.config.EventPublicationAutoConfiguration
org.springframework.modulith.events.jackson.JacksonEventSerializationConfiguration
org.springframework.modulith.events.jpa.JpaEventPublicationAutoConfiguration
org.springframework.boot.data.jpa.autoconfigure.DataJpaRepositoriesAutoConfiguration
